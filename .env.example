# =====================================================================
# MS Sons Tours - Docker Compose environment template (project root)
# =====================================================================
# docker-compose.yml interpolates ${VARIABLE} from this file. Docker does
# NOT read backend/.env or frontend/.env for these values.
#
# Setup (REQUIRED before `docker compose up`):
#   1. Copy this file to the real, git-ignored .env:
#        cp .env.example .env
#   2. Generate a strong random JWT secret and paste it into .env:
#        openssl rand -base64 48
#   3. Edit any other values you need (FRONTEND_URL, SITE_URL, FRONTEND_PORT).
#
# The real .env is listed in .gitignore and must NEVER be committed.
# =====================================================================

# ----- Required -----

# Secret used to sign admin JWT tokens.
# The backend refuses to start with this placeholder in production, and
# `docker compose config` fails fast if JWT_SECRET is unset. Generate a
# strong value with:
#   openssl rand -base64 48
JWT_SECRET=change-this-in-production

# ----- Optional (docker-compose.yml provides sane defaults) -----

# Origin of the frontend SPA. Used for CORS and frontend/backend integration.
# Leave as-is for local development; set to your public URL in production.
FRONTEND_URL=http://localhost:5173

# Public site origin used for canonical URLs, Open Graph tags and sitemaps.
# Set to your production domain.
SITE_URL=https://www.mssons.com

# Host port the frontend container publishes on (container is always port 80).
FRONTEND_PORT=5173

# ----- Email notifications (booking inquiries) -----

# Gmail SMTP credentials used by the backend to send booking notification
# emails. SMTP_APP_PASSWORD must be a Gmail "App Password" (NOT your regular
# Gmail password), generated from your Google Account's Security settings
# after enabling 2-Step Verification: https://myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password