DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ms_sons_tours?schema=public"
REDIS_URL="redis://localhost:6379"
KAFKA_BROKERS="localhost:9092"
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
# Production: the exact frontend origin (scheme + host, no trailing slash), e.g.
# "https://app.mssons.com". The frontend and backend must share the same
# registrable domain (same-site) for the admin auth cookie to be sent - Render's
# default *.onrender.com domains are cross-site (onrender.com is a public suffix)
# and the browser will withhold the SameSite=None cookie, breaking admin login.
FRONTEND_URL="http://localhost:5173"
WHATSAPP_NUMBER="923713011519"
NODE_ENV="development"

# Gmail SMTP credentials for booking notification emails.
# SMTP_APP_PASSWORD must be a Gmail "App Password" (NOT your regular Gmail
# password), generated from your Google Account's Security settings after
# enabling 2-Step Verification: https://myaccount.google.com/apppasswords
SMTP_USER="your-gmail-address@gmail.com"
SMTP_APP_PASSWORD="your-16-character-app-password"